{
  "info": {
    "_postman_id": "87f4cbb8-c7aa-4ac7-a23f-5dbde1a66d1b",
    "name": "Task Desk - Tasks",
    "description": "Set token to a valid Firebase ID token for an owner/admin in an organization. Run the requests in order: Setup creates a test project and saves projectId; Create task saves taskId for Get, Update, and Delete.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Setup: Create test project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Task Test Project\",\n  \"description\": \"Created by the Task Desk task collection\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/project",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "project"
              ]
            },
            "description": "Run this setup request first. It creates a project and saves its ID to the projectId collection variable for the task requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creates a project for task requests', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  const projectId = body.data && (body.data._id || body.data.id);",
                  "  pm.expect(projectId, 'project ID').to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('projectId', projectId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List project tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/task/project/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task",
                "project",
                "{{projectId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns the project task list', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman task\",\n  \"description\": \"Created by the Task Desk Postman collection\",\n  \"status\": \"todo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/task/project/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task",
                "project",
                "{{projectId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creates a task and saves its ID', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  const taskId = body.data && (body.data._id || body.data.id);",
                  "  pm.expect(taskId, 'created task ID').to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('taskId', taskId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get created task (after Create task)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/task/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task",
                "{{taskId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns the created task', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data._id || body.data.id).to.eql(pm.collectionVariables.get('taskId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update created task (after Create task)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Postman task\",\n  \"status\": \"in_progress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/task/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task",
                "{{taskId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Updates the created task', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.title).to.eql('Updated Postman task');",
                  "  pm.expect(body.data.status).to.eql('in_progress');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete created task (after Create task)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/task/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task",
                "{{taskId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Soft-deletes the created task', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
