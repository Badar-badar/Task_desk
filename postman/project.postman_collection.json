{
  "info": {
    "_postman_id": "40df30f7-59ba-4f4b-99d0-03acdc1f47fc",
    "name": "Task Desk - Projects",
    "description": "Set token to a valid Firebase ID token for a user in an organization. Create/list/update/delete require the owner or admin role. Run Create project before Get, Update, or Delete; its ID is saved as createdProjectId. Copy that ID to the Task collection's projectId to test tasks. Delete permanently removes the project; use a test project only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdProjectId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Projects",
      "item": [
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/project",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "project"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns the organization project list', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Project\",\n  \"description\": \"Created by the Task Desk Postman collection\",\n  \"status\": \"active\",\n  \"startDate\": \"2026-11-16T00:00:00.000Z\",\n  \"dueDate\": \"2026-12-16T00:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/project",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "project"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creates a project and saves its ID', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  const projectId = body.data && (body.data._id || body.data.id);",
                  "  pm.expect(projectId, 'project ID').to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('createdProjectId', projectId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get created project",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/project/{{createdProjectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "project",
                "{{createdProjectId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns the created project', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data._id || body.data.id).to.eql(pm.collectionVariables.get('createdProjectId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update created project",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Postman Test Project\",\n  \"status\": \"on_hold\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/project/{{createdProjectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "project",
                "{{createdProjectId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Updates the created project', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.name).to.eql('Updated Postman Test Project');",
                  "  pm.expect(body.data.status).to.eql('on_hold');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete created project (permanent)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/project/{{createdProjectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "project",
                "{{createdProjectId}}"
              ]
            },
            "description": "Permanently deletes the project identified by createdProjectId. Only run this for a project created for testing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Permanently deletes the created project', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
