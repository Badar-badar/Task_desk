{
  "info": {
    "_postman_id": "51f6421b-e1d5-4db4-b0cc-aab1c18e9f15",
    "name": "Task Desk - workspaces",
    "description": "Set the token collection variable to a valid Firebase ID token. Create workspace only works for a registered user who is not already in a workspace. Member management requires memberEmail to be another registered user who is not already in a workspace. Run Delete workspace only against a disposable test workspace.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberId",
      "value": "",
      "type": "string"
    },
    {
      "key": "workspaceId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "workspaces",
      "item": [
        {
          "name": "Create workspace (user must not belong to one)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test workspace\",\n  \"description\": \"Created by the Task Desk Postman collection\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspace",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspace"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creates a workspace and saves its ID', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  const workspaceId = body.data && (body.data._id || body.data.id);",
                  "  pm.expect(workspaceId, 'workspace ID').to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('workspaceId', workspaceId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my workspace (after create, or if already a member)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workspace",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspace"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns the current workspace and role', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.workspace).to.be.an('object');",
                  "  pm.expect(body.data.role).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update my workspace",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Postma workspace\",\n  \"description\": \"Updated by the Task Desk Postman collection\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspace",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspace"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Updates the workspace', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.name).to.eql('Updated Postma workspace');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List workspace members",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workspace/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspace",
                "members"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns workspace members', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Add member (set memberEmail to an existing user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"role\": \"employee\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspace/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspace",
                "members"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Adds a member and saves their ID', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  const memberId = body.data && (body.data._id || body.data.id);",
                  "  pm.expect(memberId, 'member ID').to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('memberId', memberId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Change member role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspace/members/{{memberId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspace",
                "members",
                "{{memberId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Changes the member role', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.role).to.eql('admin');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove member",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workspace/members/{{memberId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspace",
                "members",
                "{{memberId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Removes the selected member', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete workspace (run only against a disposable test workspace)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workspace",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspace"
              ]
            },
            "description": "Soft-deletes the current workspace and detaches all of its members. Only run this against a disposable test workspace."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Soft-deletes the workspace', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
