{
  "info": {
    "_postman_id": "51f6421b-e1d5-4db4-b0cc-aab1c18e9f15",
    "name": "Task Desk - Organizations",
    "description": "Set the token collection variable to a valid Firebase ID token. Create organization only works for a registered user who is not already in an organization. Member management requires memberEmail to be another registered user who is not already in an organization. Run Delete organization only against a disposable test organization.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberId",
      "value": "",
      "type": "string"
    },
    {
      "key": "organizationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Organizations",
      "item": [
        {
          "name": "Create organization (user must not belong to one)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Organization\",\n  \"description\": \"Created by the Task Desk Postman collection\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/organization",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "organization"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creates an organization and saves its ID', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  const organizationId = body.data && (body.data._id || body.data.id);",
                  "  pm.expect(organizationId, 'organization ID').to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('organizationId', organizationId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my organization (after create, or if already a member)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/organization",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "organization"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns the current organization and role', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.organization).to.be.an('object');",
                  "  pm.expect(body.data.role).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update my organization",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Postman Organization\",\n  \"description\": \"Updated by the Task Desk Postman collection\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/organization",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "organization"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Updates the organization', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.name).to.eql('Updated Postman Organization');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List organization members",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/organization/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "organization",
                "members"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns organization members', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Add member (set memberEmail to an existing user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"role\": \"employee\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/organization/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "organization",
                "members"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Adds a member and saves their ID', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  const memberId = body.data && (body.data._id || body.data.id);",
                  "  pm.expect(memberId, 'member ID').to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('memberId', memberId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Change member role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/organization/members/{{memberId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "organization",
                "members",
                "{{memberId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Changes the member role', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.role).to.eql('admin');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove member",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/organization/members/{{memberId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "organization",
                "members",
                "{{memberId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Removes the selected member', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete organization (run only against a disposable test organization)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/organization",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "organization"
              ]
            },
            "description": "Soft-deletes the current organization and detaches all of its members. Only run this against a disposable test organization."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Soft-deletes the organization', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
